# ── Database — Supabase PostgreSQL (same database as user-portal) ────────────
# Runtime: transaction-mode pooler (IPv4). pgbouncer=true disables Prisma
# prepared statements (required by Supavisor transaction pooling).
# NOTE: URL-encode special characters in the password (@ → %40)!
DATABASE_URL="postgresql://postgres.<project-ref>:<URL-ENCODED-PASSWORD>@<pooler-region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"

# DDL: session-mode pooler — used by `prisma db push` / `prisma migrate`
DIRECT_URL="postgresql://postgres.<project-ref>:<URL-ENCODED-PASSWORD>@<pooler-region>.pooler.supabase.com:5432/postgres"

# ── Auth ─────────────────────────────────────────────────────────────────────
# JWT signing secret (generate with: openssl rand -hex 32).
# MUST be identical in user-portal and admin-portal (sessions are shared).
AUTH_SECRET="<long-random-string>"

# ── Supabase Storage (image uploads: products, banners, logo/favicon) ────────
# Project URL + secret key from Supabase Dashboard → Settings → API.
# A public "uploads" bucket is created automatically on first upload.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."
