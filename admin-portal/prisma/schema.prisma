generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============ USERS & AUTH ============

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  phone     String?
  role      String   @default("CUSTOMER") // CUSTOMER | ADMIN
  status    String   @default("ACTIVE") // ACTIVE | BLOCKED
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  resetTokens   PasswordResetToken[]

  @@index([role])
  @@index([status])
}

// Password reset tokens (single-use, 1h expiry)
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  country   String  @default("India")
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ============ CATALOG ============

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  status      String   @default("ACTIVE") // ACTIVE | HIDDEN
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  price       Int // selling price in paise
  mrp         Int // list price in paise
  sku         String   @unique
  stock       Int      @default(0)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images      String   @default("[]") // JSON array of URLs
  tags        String   @default("[]") // JSON array of strings
  // Rich catalog fields (Amazon/Flipkart-style PDP)
  brand       String?  // e.g. "Shoperic" / "SonicWave"
  warranty    String?  // e.g. "1 year manufacturer warranty"
  highlights  String   @default("[]") // JSON array of bullet-point key features
  specifications String @default("{}") // JSON object of key-value pairs (Brand, Model, Color, Weight…)
  status      String   @default("ACTIVE") // ACTIVE | DRAFT | ARCHIVED
  featured    Boolean  @default(false)
  rating      Float    @default(0)
  reviewCount Int      @default(0)
  soldCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reviews       Review[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]

  @@index([categoryId, status])
  @@index([featured, status])
  @@index([status, createdAt]) // newest products listing
  @@index([status, price])     // price sort/filter
  @@index([status, rating])    // rating sort/filter
  @@index([status, soldCount]) // best-seller sort
  @@index([slug])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int // 1..5
  title     String?
  comment   String
  status    String   @default("PUBLISHED") // PUBLISHED | HIDDEN
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId])
}

// ============ CART & WISHLIST ============

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// ============ ORDERS & PAYMENTS ============

model Order {
  id             String   @id @default(cuid())
  orderNumber    String   @unique
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  addressJson    String // snapshot of delivery address
  subtotal       Int // paise
  discount       Int      @default(0)
  shipping       Int      @default(0)
  total          Int
  couponCode     String?
  paymentMethod  String // RAZORPAY | COD
  paymentStatus  String   @default("PENDING") // PENDING | PAID | FAILED | REFUNDED
  paymentId      String? // gateway payment id
  razorpayOrderId String?
  status         String   @default("PLACED") // PLACED | CONFIRMED | SHIPPED | DELIVERED | CANCELLED
  notes          String?
  // Shipping & tracking (set when admin marks SHIPPED)
  courierName    String? // e.g. Delhivery, BlueDart, DTDC
  trackingNumber String? // AWB / consignment number
  trackingUrl    String? // direct courier tracking link
  // Lifecycle timestamps (audit-friendly)
  confirmedAt    DateTime?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items  OrderItem[]
  events OrderEvent[]

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

// Audit trail — one row per status / payment / tracking change
model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String   // STATUS | PAYMENT | TRACKING | NOTE
  value     String?  // new value (e.g. SHIPPED, PAID, the tracking number)
  note      String?  // human-readable detail
  createdBy String?  // admin email or "system" / "customer"
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String // snapshot
  image     String // snapshot
  price     Int // unit price snapshot in paise
  quantity  Int
}

// ============ MARKETING ============

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  type        String    @default("PERCENT") // PERCENT | FLAT
  value       Int // percent (1-100) if PERCENT else amount in paise
  minOrder    Int       @default(0) // paise
  maxDiscount Int? // paise, for PERCENT
  usageLimit  Int? // max total redemptions
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  status      String    @default("ACTIVE") // ACTIVE | DISABLED
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  image     String
  link      String? // in-app hash link e.g. /shop?category=electronics
  ctaText   String   @default("Shop Now")
  position  String   @default("HERO") // HERO | STRIP
  status    String   @default("ACTIVE") // ACTIVE | HIDDEN
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============ SITE SETTINGS (single row) ============

model SiteSetting {
  id                 String   @id @default("singleton")
  siteName           String   @default("Shoperic")
  tagline            String   @default("Everything you love, delivered.")
  announcement       String? // top bar text; empty = hidden
  logoUrl            String?
  faviconUrl         String?
  primaryColor       String   @default("#ea580c") // applied sitewide at runtime
  supportEmail       String   @default("support@shoperic.com")
  supportPhone       String   @default("+91 90000 00000")
  // SEO
  seoTitle           String?
  seoDescription     String?
  seoKeywords        String?
  // Payments
  codEnabled         Boolean  @default(true)
  razorpayEnabled    Boolean  @default(false)
  razorpayKeyId      String?
  razorpayKeySecret  String?
  razorpayWebhookSecret String? // for verifying webhook signatures
  // Email (SMTP — provider-agnostic: Gmail, SES, Resend SMTP, Brevo…)
  smtpHost           String?
  smtpPort           Int      @default(587)
  smtpUser           String?
  smtpPass           String?
  smtpFrom           String?  // e.g. "Shoperic <orders@shoperic.com>"
  // Shipping (paise)
  shippingFee        Int      @default(4900)
  freeShippingAbove  Int      @default(99900)
  // Feature toggles
  wishlistEnabled    Boolean  @default(true)
  reviewsEnabled     Boolean  @default(true)
  couponsEnabled     Boolean  @default(true)
  maintenanceMode    Boolean  @default(false)
  socialJson         String   @default("{}") // {instagram, twitter, facebook, youtube}
  // Cross-portal links (monorepo: portals deploy separately)
  adminUrl           String?  // e.g. https://admin.yourstore.com — shown in the store's account menu
  storeUrl           String?  // e.g. https://www.yourstore.com — "View Store" button in the admin console
  updatedAt          DateTime @updatedAt
}
